{
  "name": "api",
  "version": "1.0.0",
  "description": "KickOff API - World Cup 2026 match viewer and friend betting API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "keywords": ["fastify", "world-cup", "betting", "api"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "fastify": "^5.2.3",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.4",
    "@fastify/sensible": "^6.0.2",
    "prisma": "^6.2.1",
    "@prisma/client": "^6.2.1",
    "@supabase/supabase-js": "^2.49.2",
    "zod": "^3.24.2",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "axios": "^1.7.9",
    "firebase-admin": "^13.2.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "ts-node-dev": "^2.0.0",
    "@types/node": "^22.15.6",
    "@types/node-cron": "^3.0.11",
    "vitest": "^2.1.8",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/parser": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
